{
  "site": {
    "title": "SocialCrop",
    "base_url": "https://socialcrop.app",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/logo.png",
    "logo_darkmode": "/images/logo-darkmode.png",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "SocialCrop"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": false,
    "content": "<span class='text-center block'>⭐ Loving SocialCrop? <a class='underline' href='https://github.com' target='_blank' rel='noopener'>Star on Github</a></span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "SocialCrop © 2025 · All rights reserved"
  },

  "navigation_button": {
    "enable": true,
    "label": "Github",
    "link": "https://github.com"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "SocialCrop",
    "meta_image": "/images/og-image.png",
    "meta_description": "Free online social media image resizer and cropper. 100% free, no quality loss, instant browser processing."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
